# Public build configuration only. Never put credentials in VITE_* variables.
# Export the SAME origin for pnpm build AND the Gradle build (Gradle reads process env).
VITE_DOTS_API_ORIGIN=https://dots.example.com
DOTS_DOMAIN=dots.example.com
DOTS_UPSTREAM_NETWORK=dots-upstream
# Required by Compose. Use the full SHA of your reviewed local commit.
DOTS_SHA=
# Optional exact web origins, comma-separated; never use a wildcard.
DOTS_CORS_ORIGINS=
